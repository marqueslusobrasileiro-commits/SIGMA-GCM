{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "open:edge": "cmd /c start msedge http://127.0.0.1:3000",
    "start": "npx tsx server.ts",
    "build": "vite build",
    "build:android": "set CAPACITOR=true&& vite build --mode capacitor",
    "cap:sync:android": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "android:bundle": "npm run build:android && npx cap sync android",
    "android:apk": "npm run android:bundle && cd android && gradlew.bat assembleDebug --no-daemon",
    "preview": "vite preview",
    "preview:local": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:edge": "start \"\" \"http://127.0.0.1:4173\" && npm run preview:local",
    "preview:open": "start \"\" \"http://127.0.0.1:4173\"",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "chrome >= 60",
    "android >= 8"
  ],
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capawesome/capacitor-google-sign-in": "^0.1.2",
    "@capgo/capacitor-native-biometric": "^8.4.2",
    "@aws-sdk/client-s3": "^3.888.0",
    "@google/genai": "^1.29.0",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@react-google-maps/api": "^2.20.8",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@simplewebauthn/types": "^12.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@supabase/supabase-js": "^2.57.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^10.6.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^7.0.6",
    "open-location-code": "^1.0.3",
    "postcss-preset-env": "^11.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "vite-plugin-compression": "^0.5.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  }
}
